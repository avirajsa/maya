# Maya Environment Configuration

# ─── LLM / OpenRouter ────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
# Primary: anthropic/claude-sonnet-4-5
# Fallback 1: openai/gpt-4o-mini
# Fallback 2: meta-llama/llama-3.3-70b-instruct:free
LLM_PRIMARY=anthropic/claude-sonnet-4-5
LLM_FALLBACK_1=openai/gpt-4o-mini
LLM_FALLBACK_2=meta-llama/llama-3.3-70b-instruct:free
LLM_TEMPERATURE=0.7

# ─── Voice ───────────────────────────────────────────────────────────────────
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
TTS_VOICE=en-GB-SoniaNeural
TTS_PROVIDER=edge
# For ElevenLabs (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ─── Home Assistant ──────────────────────────────────────────────────────────
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=

# ─── App ─────────────────────────────────────────────────────────────────────
MAYA_NAME=Maya
LOG_LEVEL=INFO
